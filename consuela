#!/bin/sh
# Reclaim Xcode leftover data, package-manager caches, and Docker disk.

set -eu

NL='
'
TAB=$(printf '\t')
TILDE='~'

usage() {
  cat <<'EOF'
usage: consuela [--xcode] [--cache] [--docker | --docker-all | --docker-dangling]
                [--xcode-previews] [--xcodebuildmcp]
                [--docker-volume NAME]... [-y] [--dry-run]
       consuela --report [-y]
       consuela --update
       consuela --version

With no group flags, scans and cleans --xcode, --cache, and --docker after
confirmation. The other flags are opt-in and never part of a default run.
Any group flag limits the run to the groups you name.

  --xcode             XCTestDevices, unavailable simulators and runtimes
                      (skipped when consuela finds more than one Xcode),
                      DerivedData, CoreSimulator caches, simulator logs,
                      xcodebuild cache, SwiftPM cache, CocoaPods cache
  --cache             npm, npx, Yarn, pnpm, Bun, pip, uv, Poetry (cache and
                      artifacts; virtualenvs kept), Homebrew download cache,
                      brew cleanup, TypeScript, node-gyp, Corepack, Next.js
                      SWC, Prisma, Electron, and Deno caches. At a
                      terminal, also asks about each other folder of 100M
                      or more in ~/.cache and ~/Library/Caches
  --docker            unused images (including tagged), containers, build
                      cache; volumes kept. Same as --docker-all
  --docker-all        same as --docker
  --docker-dangling   dangling images, stopped containers, and build cache;
                      volumes kept

Opt-in:
  --xcode-previews    Xcode Previews simulators
                      (xcrun simctl --set <Previews set> delete all)
  --xcodebuildmcp     XcodeBuildMCP DerivedData and finished test products;
                      workspaces with a held lock are skipped
  --docker-volume NAME
                      delete one named Docker volume; repeat for more.
                      Each needs the name typed at a terminal, even with -y.
                      Refused for volumes a container uses and for
                      endpoints that are not a local unix:// socket

  -y, --yes           skip the prompt; still asks while Xcode tools run;
                      Docker cleanup is skipped unless Docker uses a
                      local unix:// socket
  --dry-run           print the plan without deleting
  --report            print a read-only storage report: cleanup targets per
                      flag, Docker volumes, and data to review by hand.
                      Never deletes, even with -y
  --update            replace this consuela file with the latest version
                      from GitHub, or print the Homebrew command on a
                      Homebrew install; must be the only argument
  --version           print the version; must be the only argument

Exits 0 after a dry run or report, when nothing needs cleaning, when every
step succeeds, after --version, or after an update. Exits 1 for a usage
error, a declined prompt, a failed step, a failed update, or when consuela
cannot start.
Failed steps are listed on stderr. Anything that cannot be scanned, such
as Docker with the daemon stopped, prints a warning and is skipped
without changing the exit status.
EOF
}

VERSION=0.1.0
INSTALL_METHOD=script
INSTALLER_URL="https://raw.githubusercontent.com/exddc/consuela/main/install.sh"

# Installs the latest consuela into the directory of $1.
self_update() {
  if [ "$INSTALL_METHOD" = brew ]; then
    echo "consuela was installed with Homebrew. To update, run: brew upgrade consuela"
    return 0
  fi
  case "$1" in
    */consuela) ;;
    *)
      echo "error: run consuela by its path, for example ~/.local/bin/consuela --update" >&2
      return 1
      ;;
  esac
  if [ -L "$1" ] || [ ! -f "$1" ]; then
    echo "error: $1 is not a regular file" >&2
    return 1
  fi
  dir=$(canonical_dir "${1%/*}/") || return 1
  installer=$(mktemp "${TMPDIR:-/tmp}/consuela-install.XXXXXX") || return 1
  trap 'rm -f "$installer"' EXIT
  curl -fsSL --connect-timeout 10 --max-time 120 "$INSTALLER_URL" -o "$installer" &&
    CONSUELA_BIN=$dir sh "$installer"
}

have() {
  command -v "$1" >/dev/null 2>&1
}

warn() {
  echo "warning: $*" >&2
}

# Tools in /usr/bin such as xcrun and python3 are stubs that open an install
# dialog when xcode-select has no developer directory.
have_dev_tool() {
  tool=$(command -v "$1" 2>/dev/null) || return 1
  [ "$(canonical_dir "${tool%/*}")" = /usr/bin ] || return 0
  xcode-select -p >/dev/null 2>&1
}

xcode_ready() {
  have_dev_tool xcrun && xcrun --find simctl >/dev/null 2>&1
}

# Kilobytes occupied by a path. Missing paths are 0.
du_kb() {
  if [ ! -e "$1" ]; then
    echo 0
    return 0
  fi
  kb=$(du -sk "$1" 2>/dev/null | awk '{print $1}')
  case "$kb" in
    ''|*[!0-9]*) echo 0 ;;
    *) echo "$kb" ;;
  esac
}

fmt_kb() {
  awk -v kb="${1:-0}" 'BEGIN {
    if (kb < 1) { printf "0B"; exit }
    bytes = kb * 1024
    if (bytes < 1024) printf "%dB", bytes
    else if (bytes < 1048576) printf "%dK", kb
    else if (bytes < 1073741824) printf "%.1fM", bytes / 1048576
    else printf "%.1fG", bytes / 1073741824
  }'
}

first_line() {
  "$@" 2>/dev/null | sed -n '1p'
}

# Fails for paths containing a newline. The x keeps $(...) from stripping one.
canonical_dir() {
  [ -d "$1" ] || return 1
  resolved=$(CDPATH='' cd -P -- "$1" && pwd -P && echo x) || return 1
  resolved=${resolved%?x}
  case "$resolved" in
    *"$NL"*) return 1 ;;
  esac
  printf '%s\n' "$resolved"
}

# Like canonical_dir, but also resolves a file or a missing last component.
canonical_path() {
  if [ -d "$1" ] && [ ! -L "$1" ]; then
    canonical_dir "$1"
    return
  fi
  parent=$(canonical_dir "${1%/*}") || return 1
  printf '%s/%s\n' "$parent" "${1##*/}"
}

# Prints "<kb> ok", "<kb> partial" when du could not read everything, or
# "missing".
measure_kb() {
  if [ ! -e "$1" ] && [ ! -L "$1" ]; then
    echo missing
    return 0
  fi
  st=ok
  out=$(du -sk "$1" 2>/dev/null) || st=partial
  kb=${out%%[!0-9]*}
  printf '%s %s\n' "${kb:-0}" "$st"
}

# If command exists and prints a non-empty first line, use that; else fallback.
# Usage: cache_path_or_default <fallback> <cmd> [args...]
cache_path_or_default() {
  fallback=$1
  shift
  got=
  if [ $# -gt 0 ] && have "$1"; then
    got=$(first_line "$@") || got=
  fi
  if [ -n "$got" ]; then
    printf '%s\n' "$got"
  else
    printf '%s\n' "$fallback"
  fi
}

yarn_cache_paths() {
  p=$(cache_path_or_default "" yarn cache dir)
  if [ -n "$p" ]; then
    printf '%s\n' "$p"
    return 0
  fi
  printf '%s\n' \
    "$HOME/Library/Caches/Yarn" \
    "$HOME/.yarn/cache" \
    "$HOME/.cache/yarn"
}

uv_cache_paths() {
  p=$(cache_path_or_default "" uv cache dir)
  if [ -n "$p" ]; then
    printf '%s\n' "$p"
    return 0
  fi
  printf '%s\n' "$HOME/Library/Caches/uv" "$HOME/.cache/uv"
}

paths_du_kb() {
  total=0
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    total=$((total + $(du_kb "$p")))
  done
  printf '%s\n' "$total"
}

init_safety() {
  HOME_REAL=$(canonical_dir "$HOME") || {
    echo "cannot resolve HOME: $HOME" >&2
    exit 1
  }
}

path_is_allowed_real() {
  h=$HOME_REAL
  case "$1" in
    *"$NL"*|*/) return 1 ;;
    "$h"/Library/Caches/?*|"$h"/.cache/?*|\
    "$h"/Library/Developer/Xcode/DerivedData|"$h"/Library/Developer/Xcode/DerivedData/*|\
    "$h"/Library/Developer/CoreSimulator/Caches|"$h"/Library/Developer/CoreSimulator/Caches/*|\
    "$h"/Library/Developer/XCTestDevices|"$h"/Library/Developer/XCTestDevices/*|\
    "$h"/Library/Logs/CoreSimulator|"$h"/Library/Logs/CoreSimulator/*|\
    "$h"/.npm|"$h"/.npm/*|\
    "$h"/.bun/install/cache|"$h"/.bun/install/cache/*|\
    "$h"/.yarn/cache|"$h"/.yarn/cache/*|\
    "$h/Library/Developer/Xcode/UserData/Previews/Simulator Devices") return 0 ;;
  esac
  mcp_generated_path "$1" DerivedData
}

MCP_WORKSPACES_REL=Library/Developer/XcodeBuildMCP/workspaces

# Succeeds when $1 is exactly <XcodeBuildMCP workspaces>/<one name>/$2.
mcp_generated_path() {
  mgp_rest=${1#"$HOME_REAL/$MCP_WORKSPACES_REL/"}
  [ "$mgp_rest" != "$1" ] || return 1
  mgp_ws=${mgp_rest%%/*}
  case "$mgp_ws" in
    ''|.|..) return 1 ;;
  esac
  [ "$mgp_rest" = "$mgp_ws/$2" ]
}

path_is_allowed() {
  real=$(canonical_dir "$1") || return 1
  path_is_allowed_real "$real"
}

# Prints the paths in $1 that are missing or allowed. Warns about the rest.
allowed_paths() {
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    if [ -e "$p" ] && ! path_is_allowed "$p"; then
      warn "skipping unsafe path: $p"
    else
      printf '%s\n' "$p"
    fi
  done <<EOF
$1
EOF
}

# Prints the paths in $1 whose top-level entries the current user owns.
# Warns about the rest: rm cannot delete another user's folders.
owned_paths() {
  uid=$(id -u)
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    foreign=$(find -H "$p" -mindepth 1 -maxdepth 1 ! -user "$uid" 2>/dev/null | sed -n '1p')
    if [ -n "$foreign" ]; then
      warn "skipping $p: $foreign is owned by $(stat -f %Su "$foreign" 2>/dev/null || echo another user); remove it with sudo rm -rf"
    else
      printf '%s\n' "$p"
    fi
  done <<EOF
$1
EOF
}

# Remove directory contents, keep the directory.
# Refuses paths outside the allowlist.
clear_dir() {
  [ -d "$1" ] || return 0
  if ! real=$(canonical_dir "$1") || ! path_is_allowed_real "$real"; then
    echo "refusing to delete unsafe path: $1" >&2
    return 1
  fi
  find "$real" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
}

clear_paths_from() {
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    run_ok clear_dir "$p"
  done <<EOF
$1
EOF
}

plan_init() {
  PLAN_DIR=$(mktemp -d "${TMPDIR:-/tmp}/consuela.XXXXXX")
  PLAN_COUNT=0
  CLAIMED=
}

# Sets CLAIMED_PATHS to the paths in $1 that do not overlap a path an
# earlier plan line already counts, and claims them. Warns about the rest.
# Runs in the current shell so the claims persist.
claim_paths() {
  CLAIMED_PATHS=
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    real=$(canonical_path "$p") || real=$p
    clash=
    while IFS= read -r c; do
      [ -n "$c" ] || continue
      case "$real/" in "$c/"*) clash=$c ;; esac
      case "$c/" in "$real/"*) clash=$c ;; esac
    done <<EOF
$CLAIMED
EOF
    if [ -n "$clash" ]; then
      warn "skipping $p: overlaps $clash, already in the plan"
      continue
    fi
    CLAIMED="$CLAIMED$real$NL"
    CLAIMED_PATHS="$CLAIMED_PATHS$p$NL"
  done <<EOF
$1
EOF
}

plan_rec() {
  printf '%s/%04d' "$PLAN_DIR" "$1"
}

add() {
  group=$1
  kb=${2:-0}
  label=$3
  action=$4
  arg=${5-}
  kind=${6:-firm}
  case "$kb" in
    ''|*[!0-9]*) kb=0 ;;
  esac
  if [ "$kind" != unknown ]; then
    [ "$kb" -gt 0 ] || return 0
  fi
  PLAN_COUNT=$((PLAN_COUNT + 1))
  rec=$(plan_rec "$PLAN_COUNT")
  mkdir "$rec"
  printf '%s\n' "$group" >"$rec/group"
  printf '%s\n' "$kb" >"$rec/kb"
  if [ "$kind" = unknown ]; then
    echo '?' >"$rec/size"
  else
    fmt_kb "$kb" >"$rec/size"
  fi
  printf '%s\n' "$label" >"$rec/label"
  printf '%s\n' "$action" >"$rec/action"
  printf '%s' "$arg" >"$rec/arg"
  printf '%s\n' "$kind" >"$rec/kind"
}

add_estimate() {
  add "$1" "$2" "$3" "$4" "${5-}" estimate
}

claimed_kb() {
  printf '%s' "$CLAIMED_PATHS" | paths_du_kb
}

# Usage: add_clear <group> <label> <newline-separated paths> [action]
add_clear() {
  claim_paths "$(owned_paths "$(allowed_paths "$3")")"
  paths=${CLAIMED_PATHS%"$NL"}
  add "$1" "$(printf '%s\n' "$paths" | paths_du_kb)" "$2" "${4:-clear_dir}" "$paths"
}

# Usage: sum_plan_kb [kind] [space-separated groups]
sum_plan_kb() {
  s=0
  i=1
  while [ "$i" -le "$PLAN_COUNT" ]; do
    rec=$(plan_rec "$i")
    if { [ -z "${1-}" ] || [ "$(sed -n '1p' "$rec/kind")" = "$1" ]; } &&
      in_groups "$(sed -n '1p' "$rec/group")" "${2-}"; then
      kb=$(sed -n '1p' "$rec/kb")
      s=$((s + kb))
    fi
    i=$((i + 1))
  done
  printf '%s\n' "$s"
}

# Usage: count_plan <kind> [space-separated groups]
count_plan() {
  n=0
  i=1
  while [ "$i" -le "$PLAN_COUNT" ]; do
    rec=$(plan_rec "$i")
    if [ "$(sed -n '1p' "$rec/kind")" = "$1" ] &&
      in_groups "$(sed -n '1p' "$rec/group")" "${2-}"; then
      n=$((n + 1))
    fi
    i=$((i + 1))
  done
  printf '%s\n' "$n"
}

# An empty group list matches every group.
in_groups() {
  [ -n "$2" ] || return 0
  case " $2 " in
    *" $1 "*) return 0 ;;
  esac
  return 1
}

# Usage: fmt_run_total <firm kb> <estimated kb> [items of unknown size]
fmt_run_total() {
  unknown=${3:-0}
  if [ "$2" -le 0 ]; then
    out=$(fmt_kb "$1")
  elif [ "$1" -le 0 ]; then
    out="~$(fmt_kb "$2") estimated"
  else
    out="$(fmt_kb "$1"), plus ~$(fmt_kb "$2") estimated"
  fi
  if [ "$unknown" -gt 0 ]; then
    if [ "$1" -le 0 ] && [ "$2" -le 0 ]; then
      out="$unknown item(s) of unknown size"
    else
      out="$out, plus $unknown item(s) of unknown size"
    fi
  fi
  printf '%s' "$out"
}

# Usage: print_plan <pad> [print group flag]
print_plan() {
  pad=
  if [ "${1:-0}" -gt 0 ]; then
    pad=' '
  fi
  i=1
  while [ "$i" -le "$PLAN_COUNT" ]; do
    rec=$(plan_rec "$i")
    mark=$pad
    if [ "$(sed -n '1p' "$rec/kind")" = estimate ]; then
      mark='~'
    fi
    flag=
    if [ -n "${2-}" ]; then
      flag=$(printf '%-17s ' "--$(sed -n '1p' "$rec/group")")
    fi
    printf '  %s%s%8s  %s\n' "$flag" "$mark" "$(sed -n '1p' "$rec/size")" "$(sed -n '1p' "$rec/label")"
    i=$((i + 1))
  done
}

fail() {
  echo "  failed: $STEP" >&2
  FAIL_COUNT=$((FAIL_COUNT + 1))
}

plan_has_group() {
  grep -qxF -- "$1" "$PLAN_DIR"/*/group 2>/dev/null
}

plan_has_xcode() {
  plan_has_group xcode || plan_has_group xcode-previews || plan_has_group xcodebuildmcp
}

# Prints matching processes, nothing when none run. Fails when pgrep cannot
# answer. Usage: pgrep_procs <pgrep args...>
pgrep_procs() {
  if ! have pgrep; then
    warn "pgrep not found"
    return 1
  fi
  pgrep "$@" && return 0
  rc=$?
  if [ "$rc" -eq 1 ]; then
    return 0
  fi
  warn "pgrep exited $rc"
  return 1
}

running_xcode_tools() {
  procs=$(pgrep_procs -lx -u "$(id -u)" 'Xcode|Simulator|xcodebuild|launchd_sim') || return 1
  if plan_has_group xcodebuildmcp; then
    mcp=$(pgrep_procs -f -u "$(id -u)" '[/]xcodebuildmcp([/ ]|$)') || return 1
    if [ -n "$mcp" ]; then
      procs="$procs${procs:+$NL}0 XcodeBuildMCP"
    fi
  fi
  [ -n "$procs" ] || return 0
  printf '%s\n' "$procs" |
    awk '{ print ($2 == "launchd_sim" ? "booted simulator" : $2) }' |
    LC_ALL=C sort -u | paste -sd ',' - | sed 's/,/, /g'
}

run_ok() {
  "$@" || fail
}

# Prints "unavailable_devices <kb>" and "unavailable_runtime <kb> <id>" lines.
# Failures warn on stderr and omit that line; they are not treated as 0 KB success.
run_simctl_scan() {
  if ! have_dev_tool python3; then
    warn "python3 not available; skipping unavailable simulator scan"
    return 0
  fi
  python3 - <<'PY'
import json, os, subprocess, sys

FIXTURES = {
    ("list", "devices", "-j"): "CONSUELA_FIXTURE_DEVICES",
    ("runtime", "list", "-j"): "CONSUELA_FIXTURE_RUNTIME_IMAGES",
    ("list", "runtimes", "-j"): "CONSUELA_FIXTURE_RUNTIMES",
}

def read_bytes(args):
    envkey = FIXTURES.get(tuple(args))
    path = os.environ.get(envkey) if envkey else None
    if path:
        with open(path, "rb") as f:
            return f.read()
    return subprocess.check_output(
        ["xcrun", "simctl"] + list(args), stderr=subprocess.DEVNULL
    )

def load_json(args, what):
    data = json.loads(read_bytes(args))
    if not isinstance(data, dict):
        raise TypeError("%s JSON must be an object, got %s" % (what, type(data).__name__))
    return data

def du_kb(path):
    if not path or not os.path.exists(path):
        return 0
    try:
        out = subprocess.check_output(["du", "-sk", path], stderr=subprocess.DEVNULL)
        return int(out.split()[0])
    except (OSError, ValueError, subprocess.CalledProcessError):
        return 0

try:
    data = load_json(["list", "devices", "-j"], "devices")
    dev_kb = 0
    for devices in data.get("devices", {}).values():
        for dev in devices:
            if dev.get("isAvailable", True):
                continue
            size = dev.get("dataPathSize") or 0
            if size:
                dev_kb += int(size) // 1024
            else:
                dev_kb += du_kb(dev.get("dataPath") or "")
    print("unavailable_devices %d" % dev_kb)
except Exception as e:
    print("warning: could not scan unavailable simulators: %s" % e, file=sys.stderr)

try:
    raw = load_json(["runtime", "list", "-j"], "runtime images")
    images = {}
    for img in raw.values():
        if not isinstance(img, dict):
            continue
        images[img.get("runtimeIdentifier")] = img
        images[img.get("identifier")] = img
    data = load_json(["list", "runtimes", "-j"], "runtimes")
    for rt in data.get("runtimes", []):
        if rt.get("isAvailable"):
            continue
        ident = rt.get("identifier") or ""
        img = images.get(ident) or {}
        delete_id = img.get("identifier") or ident
        if not delete_id:
            continue
        size = img.get("sizeBytes") or 0
        if size:
            rt_kb = int(size) // 1024
        else:
            rt_kb = du_kb(rt.get("bundlePath") or "")
        print("unavailable_runtime %d %s" % (rt_kb, delete_id))
except Exception as e:
    print("warning: could not scan unavailable runtimes: %s" % e, file=sys.stderr)
PY
}

filter_xcode_apps() {
  while IFS= read -r app; do
    app=$(canonical_dir "$app") || continue
    case "$app" in
      */.Trash/*|*/.Trashes/*) continue ;;
    esac
    [ -d "$app/Contents/Developer" ] || continue
    printf '%s\n' "$app"
  done | sort -u
}

xcode_apps() {
  if [ -n "${CONSUELA_FIXTURE_XCODE_APPS-}" ]; then
    printf '%s\n' "$CONSUELA_FIXTURE_XCODE_APPS"
  else
    printf '%s\n' "$1" /Applications/Xcode*.app "$HOME"/Applications/Xcode*.app
    printf '%s/../..\n' "$(first_line xcode-select -p)"
  fi | filter_xcode_apps
}

simctl_scan_unless_multiple_xcodes() {
  scan=$(run_simctl_scan) || scan=
  if ! printf '%s\n' "$scan" | grep -q '^unavailable_[a-z]* [1-9]'; then
    printf '%s\n' "$scan"
    return 0
  fi
  spotlight=
  if [ -z "${CONSUELA_FIXTURE_XCODE_APPS-}" ]; then
    spotlight=$(mdfind "kMDItemCFBundleIdentifier == 'com.apple.dt.Xcode'" 2>/dev/null | filter_xcode_apps)
  fi
  xcodes=$(xcode_apps "$spotlight")
  n=$(printf '%s\n' "$xcodes" | grep -c .) || :
  if [ "$n" -gt 1 ]; then
    warn "found $n Xcodes; skipping unavailable simulators and runtimes:"
    printf '%s\n' "$xcodes" | sed 's/^/  /' >&2
    return 0
  fi
  if [ "$n" -eq 1 ] && [ -z "$spotlight" ] && [ -z "${CONSUELA_FIXTURE_XCODE_APPS-}" ]; then
    warn "no Xcode in Spotlight; checked only /Applications, ~/Applications, xcode-select"
  fi
  printf '%s\n' "$scan"
}

scan_xcode() {
  if xcode_ready; then
    claim_paths "$(allowed_paths "$HOME/Library/Developer/XCTestDevices")"
    XCTEST_DEVICES=${CLAIMED_PATHS%"$NL"}
    add xcode "$(claimed_kb)" "XCTestDevices" simctl_set "$XCTEST_DEVICES"

    scan_out=$(simctl_scan_unless_multiple_xcodes) || scan_out=
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      case "$line" in
        unavailable_devices\ *)
          kb=${line#unavailable_devices }
          add xcode "$kb" "Unavailable simulators (simctl delete unavailable)" simctl_unavailable
          ;;
        unavailable_runtime\ *)
          rest=${line#unavailable_runtime }
          kb=${rest%% *}
          ident=${rest#"$kb"}
          ident=${ident# }
          [ -n "$ident" ] || continue
          short=${ident##*.}
          add xcode "$kb" "Unavailable runtime $short" runtime_unavailable "$ident"
          ;;
      esac
    done <<EOF
$scan_out
EOF
  else
    warn "Xcode not found; skipping XCTestDevices, unavailable simulators, and unavailable runtimes. Install Xcode to clean them."
  fi

  add_clear xcode "DerivedData" "$HOME/Library/Developer/Xcode/DerivedData"
  add_clear xcode "CoreSimulator caches" "$HOME/Library/Developer/CoreSimulator/Caches"
  add_clear xcode "Simulator logs" "$HOME/Library/Logs/CoreSimulator"
  add_clear xcode "xcodebuild cache" "$HOME/Library/Caches/com.apple.dt.xcodebuild"
  add_clear xcode "SwiftPM cache" "$HOME/Library/Caches/org.swift.swiftpm"

  cocoapods="$HOME/Library/Caches/CocoaPods"
  if have pod; then
    claim_paths "$cocoapods"
    add xcode "$(claimed_kb)" "CocoaPods cache clean --all" cocoapods "$cocoapods"
  else
    add_clear xcode "CocoaPods cache directory" "$cocoapods"
  fi
}

PREVIEWS_REL="Library/Developer/Xcode/UserData/Previews"

# Kilobytes in devices of a simctl device set; folders without a
# device.plist are not devices simctl can delete.
device_set_kb() {
  total=0
  for dev in "$1"/*/; do
    dev=${dev%/}
    [ -f "$dev/device.plist" ] || continue
    [ ! -L "$dev" ] || continue
    total=$((total + $(du_kb "$dev")))
  done
  printf '%s\n' "$total"
}

scan_xcode_previews() {
  set_dir="$HOME/$PREVIEWS_REL/Simulator Devices"
  [ -d "$set_dir" ] || return 0
  if ! xcode_ready; then
    warn "Xcode not found; skipping Xcode Previews simulators"
    return 0
  fi
  claim_paths "$(allowed_paths "$set_dir")"
  p=${CLAIMED_PATHS%"$NL"}
  [ -n "$p" ] || return 0
  add xcode-previews "$(device_set_kb "$p")" \
    "Xcode Previews simulators (simctl --set <Previews set> delete all)" simctl_set "$p"
}

# Test products names XcodeBuildMCP creates: <tool>_<UTC time>_pid<n>_<hex>.
MCP_TEST_PRODUCTS_RE='^[A-Za-z0-9][A-Za-z0-9_-]*_[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}-[0-9]{3}Z_pid[0-9]+_[a-f0-9]{8}\.xctestproducts$'

# Without ps, every process counts as alive.
pid_alive() {
  have ps || return 0
  ps -p "$1" >/dev/null 2>&1
}

# Fails when $1 is not an XcodeBuildMCP test products folder that its
# owner process has finished with.
mcp_test_products_done() {
  name=${1##*/}
  printf '%s\n' "$name" | grep -Eq "$MCP_TEST_PRODUCTS_RE" || return 1
  [ -d "$1" ] && [ ! -L "$1" ] || return 1
  [ -f "$1.xcodebuildmcp-completed" ] && return 0
  pid=${name##*_pid}
  pid=${pid%%_*}
  ! pid_alive "$pid"
}

# Fails when the workspace at $1 holds an XcodeBuildMCP lock or when its
# locks folder cannot be read.
mcp_workspace_idle() {
  [ -e "$1/locks" ] || return 0
  [ -d "$1/locks" ] && [ ! -L "$1/locks" ] || return 1
  held=$(find "$1/locks" -mindepth 1 -maxdepth 1 2>/dev/null) || return 1
  [ -z "$held" ]
}

# Fails unless every entry in DerivedData folder $1 is a folder Xcode made:
# a project folder with info.plist, or a *.noindex cache.
mcp_derived_data_generated() {
  [ -d "$1" ] && [ ! -L "$1" ] || return 1
  entries=$(find "$1" -mindepth 1 -maxdepth 1 2>/dev/null) || return 1
  while IFS= read -r e; do
    [ -n "$e" ] || continue
    [ -d "$e" ] && [ ! -L "$e" ] || return 1
    case "${e##*/}" in
      *.noindex) continue ;;
    esac
    [ -f "$e/info.plist" ] && [ ! -L "$e/info.plist" ] || return 1
  done <<EOF
$entries
EOF
}

scan_xcodebuildmcp() {
  root="$HOME/$MCP_WORKSPACES_REL"
  [ -e "$root" ] || return 0
  if [ -L "$root" ] || [ "$(canonical_dir "$root")" != "$HOME_REAL/$MCP_WORKSPACES_REL" ]; then
    warn "skipping unsafe path: $root"
    return 0
  fi
  root=$HOME_REAL/$MCP_WORKSPACES_REL
  dd_paths=
  tp_paths=
  tp_kb=0
  tp_count=0
  for ws in "$root"/*; do
    [ -d "$ws" ] || continue
    case "$ws" in
      *"$NL"*) warn "skipping XcodeBuildMCP workspace with a newline in its name"; continue ;;
    esac
    if [ -L "$ws" ]; then
      warn "skipping unsafe path: $ws"
      continue
    fi
    if ! mcp_workspace_idle "$ws"; then
      warn "skipping XcodeBuildMCP workspace ${ws##*/}: it holds a lock or its locks folder is unreadable"
      continue
    fi
    dd="$ws/DerivedData"
    if [ -e "$dd" ] || [ -L "$dd" ]; then
      if ! mcp_derived_data_generated "$dd"; then
        warn "skipping $dd: it holds entries Xcode did not create, or a symlink"
      elif path_is_allowed "$dd"; then
        dd_paths="$dd_paths$dd$NL"
      else
        warn "skipping unsafe path: $dd"
      fi
    fi
    tp="$ws/test-products"
    [ -d "$tp" ] || continue
    if [ -L "$tp" ]; then
      warn "skipping unsafe path: $tp"
      continue
    fi
    for t in "$tp"/*.xctestproducts; do
      mcp_test_products_done "$t" || continue
      tp_paths="$tp_paths$t$NL"
    done
  done
  claim_paths "$dd_paths"
  dd_paths=${CLAIMED_PATHS%"$NL"}
  dd_n=$(printf '%s' "$dd_paths" | grep -c . || :)
  add xcodebuildmcp "$(printf '%s\n' "$dd_paths" | paths_du_kb)" \
    "XcodeBuildMCP DerivedData contents ($dd_n workspace(s))" mcp_derived_data "$dd_paths"
  claim_paths "$tp_paths"
  tp_paths=${CLAIMED_PATHS%"$NL"}
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    tp_count=$((tp_count + 1))
    tp_kb=$((tp_kb + $(du_kb "$t") + $(du_kb "$t.xcodebuildmcp-completed")))
  done <<EOF
$tp_paths
EOF
  add xcodebuildmcp "$tp_kb" \
    "XcodeBuildMCP finished test products ($tp_count run(s))" mcp_test_products "$tp_paths"
}

# Prints the path a ShipItState.plist file:// URL key points to. Fails when
# the key is missing or the file cannot be parsed.
shipit_url_path() {
  url=$(plutil -extract "$2" raw -o - "$1" 2>/dev/null) || return 1
  case "$url" in
    file://*) ;;
    *) return 1 ;;
  esac
  printf '%s\n' "${url#file://}" | sed 's/%20/ /g; s:/*$::'
}

# Usage: poetry_paths <cache-dir>. Prints the cache and artifacts folders,
# or nothing when Poetry keeps virtualenvs inside one of them.
poetry_paths() {
  venvs=
  if have poetry; then
    venvs=$(first_line poetry config virtualenvs.path)
  fi
  for sub in cache artifacts; do
    p="$1/$sub"
    real=$(canonical_path "$p" 2>/dev/null) || real=$p
    vreal=$(canonical_path "$venvs" 2>/dev/null) || vreal=$venvs
    if [ -n "$venvs" ]; then
      case "$vreal/" in
        "$real/"*)
          warn "skipping Poetry $sub: virtualenvs.path $venvs is inside it"
          continue
          ;;
      esac
    fi
    printf '%s\n' "$p"
  done
}

# Usage: brew_cleanup_kb <brew cache>. Sums the sizes `brew cleanup -n` lists
# outside the download cache, which its own plan line already counts.
brew_cleanup_kb() {
  brew cleanup -n 2>/dev/null | awk -v cache="$1/" '
    /^Would remove: / {
      line = substr($0, 15)
      if (index(line, cache) == 1 || line !~ / \([^()]*\)$/) next
      n = split(line, parts, " ")
      size = parts[n]
      gsub(/[()]/, "", size)
      if (match(size, /^[0-9.]+/) == 0) next
      v = substr(size, 1, RLENGTH)
      u = substr(size, RLENGTH + 1)
      if (u == "B") kb += v / 1024
      else if (u == "KB") kb += v
      else if (u == "MB") kb += v * 1024
      else if (u == "GB") kb += v * 1048576
      else if (u == "TB") kb += v * 1073741824
    }
    END { printf "%d\n", kb }'
}

scan_cache() {
  npm_cache=$(cache_path_or_default "$HOME/.npm" npm config get cache)
  if have npm; then
    claim_paths "$npm_cache/_cacache"
    add cache "$(claimed_kb)" "npm cache clean --force" npm_clean "$npm_cache"
    add_clear cache "npx package cache" "$npm_cache/_npx"
  else
    add_clear cache "npm cache directory" "$npm_cache"
  fi

  yarn_arg=$(yarn_cache_paths)
  if have yarn; then
    claim_paths "$yarn_arg"
    add cache "$(claimed_kb)" "Yarn cache clean" yarn_clean "$yarn_arg"
  else
    add_clear cache "Yarn cache directories" "$yarn_arg"
  fi

  pnpm_store=$(cache_path_or_default "$HOME/Library/pnpm/store" pnpm store path)
  if have pnpm; then
    claim_paths "$pnpm_store"
    add_estimate cache "$(claimed_kb)" \
      "pnpm store prune (unreferenced packages)" pnpm_prune "$pnpm_store"
  fi

  bun_cache="$HOME/.bun/install/cache"
  add_clear cache "Bun install cache" "$bun_cache"

  pip_cache=
  if have_dev_tool python3; then
    pip_cache=$(first_line python3 -m pip cache dir)
  fi
  if [ -n "$pip_cache" ]; then
    claim_paths "$pip_cache"
    add cache "$(claimed_kb)" "pip cache purge" pip_purge "$pip_cache"
  else
    pip_cache="$HOME/Library/Caches/pip"
    add_clear cache "pip cache directory" "$pip_cache"
  fi

  uv_arg=$(uv_cache_paths)
  if have uv; then
    claim_paths "$uv_arg"
    add cache "$(claimed_kb)" "uv cache clean" uv_clean "$uv_arg"
  else
    add_clear cache "uv cache directories" "$uv_arg"
  fi

  poetry_dir=$(cache_path_or_default "$HOME/Library/Caches/pypoetry" poetry config cache-dir)
  case "$poetry_dir" in
    /*) ;;
    *) poetry_dir="$HOME/Library/Caches/pypoetry" ;;
  esac
  add_clear cache "Poetry cache and artifacts (virtualenvs kept)" "$(poetry_paths "$poetry_dir")"

  brew_cache=$(cache_path_or_default "$HOME/Library/Caches/Homebrew" brew --cache)
  add_clear cache "Homebrew download cache" "$brew_cache"
  if have brew; then
    add_estimate cache "$(brew_cleanup_kb "$brew_cache")" \
      "brew cleanup (old versions, stale files)" brew_cleanup
  fi

  add_clear cache "TypeScript typings cache" "$HOME/Library/Caches/typescript"
  add_clear cache "node-gyp headers" "$HOME/Library/Caches/node-gyp$NL$HOME/.cache/node-gyp"
  add_clear cache "Corepack package managers" "$HOME/.cache/node/corepack"
  add_clear cache "pnpm metadata cache" "$HOME/Library/Caches/pnpm"
  add_clear cache "Next.js SWC binaries" "$HOME/Library/Caches/next-swc"
  add_clear cache "Prisma engines" "$HOME/.cache/prisma"
  add_clear cache "Electron downloads" "$HOME/Library/Caches/electron$NL$HOME/Library/Caches/electron-builder"
  add_clear cache "Deno cache" "$HOME/Library/Caches/deno"
}

UNKNOWN_CACHE_MIN_KB=102400

# Pending app updates, Apple's caches, and folders the report lists for review.
unknown_cache_skipped() {
  case "${1##*/}" in
    *.ShipIt|*-updater|com.apple.*|com.spotify.client|ms-playwright) return 0 ;;
  esac
  return 1
}

overlaps_claimed() {
  oc_real=$(canonical_path "$1") || return 0
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    case "$oc_real/" in "$c/"*) return 0 ;; esac
    case "$c/" in "$oc_real/"*) return 0 ;; esac
  done <<EOF
$CLAIMED
EOF
  return 1
}

# Sets UNKNOWN_CACHES to "<kb><TAB><path>" lines, largest first, for cache
# folders of at least UNKNOWN_CACHE_MIN_KB that no plan line covers.
scan_unknown_caches() {
  UNKNOWN_CACHES=
  for d in "$HOME"/.cache/* "$HOME"/Library/Caches/*; do
    [ -d "$d" ] && [ ! -L "$d" ] || continue
    if unknown_cache_skipped "$d" || overlaps_claimed "$d" || ! path_is_allowed "$d"; then
      continue
    fi
    kb=$(du_kb "$d")
    [ "$kb" -ge "$UNKNOWN_CACHE_MIN_KB" ] || continue
    UNKNOWN_CACHES="$UNKNOWN_CACHES$kb$TAB$d$NL"
  done
  UNKNOWN_CACHES=$(printf '%s' "$UNKNOWN_CACHES" | LC_ALL=C sort -t "$TAB" -k1,1nr)
}

# Usage: print_unknown_caches <note>
print_unknown_caches() {
  echo "Other caches consuela does not know ($1):"
  printf '%s\n' "$UNKNOWN_CACHES" | while IFS="$TAB" read -r kb p; do
    printf '   %8s  %s\n' "$(fmt_kb "$kb")" "$TILDE${p#"$HOME"}"
  done
}

ask_unknown_caches() {
  echo "Other caches consuela does not know. Each app downloads or rebuilds what it needs again."
  while IFS="$TAB" read -r kb p <&3; do
    [ -n "$p" ] || continue
    shown="$TILDE${p#"$HOME"}"
    printf 'Wipe the contents of %s (%s)? [y/N] ' "$shown" "$(fmt_kb "$kb")"
    read -r ans || ans=n
    case "$ans" in
      y|Y|yes|YES) ;;
      *) continue ;;
    esac
    STEP="cache $shown"
    echo "Cleaning $STEP..."
    before=$FAIL_COUNT
    run_ok clear_dir "$p"
    if [ "$FAIL_COUNT" -ne "$before" ]; then
      FAILED_STEPS="$FAILED_STEPS  $STEP$NL"
    fi
  done 3<<EOF
$UNKNOWN_CACHES
EOF
}

# Asks at a terminal; lists the caches for a dry run, -y, or no terminal.
handle_unknown_caches() {
  [ -n "$UNKNOWN_CACHES" ] || return 0
  if [ "$DRY_RUN" -eq 1 ]; then
    print_unknown_caches "asked one by one at a terminal"
  elif [ "$YES" -eq 1 ] || [ ! -t 0 ]; then
    print_unknown_caches "skipped; run consuela at a terminal without -y to choose"
  else
    ask_unknown_caches
  fi
  echo
}

finish_run() {
  if [ -n "$FAILED_STEPS" ]; then
    n=$(printf '%s' "$FAILED_STEPS" | awk 'END { print NR }')
    echo "Done with $n failed step(s):" >&2
    printf '%s' "$FAILED_STEPS" >&2
    exit 1
  fi
  echo "Done."
  exit 0
}

# Docker reports sizes in decimal units, for example 6.844GB or 0B (0%).
# Prints ? for a size it cannot read.
docker_size_kb() {
  awk -v s="$1" 'BEGIN {
    gsub(/ .*/, "", s)
    n = s + 0
    u = s
    gsub(/[0-9.]/, "", u)
    u = toupper(u)
    if (u == "B") kb = n / 1024
    else if (u == "KB") kb = n * 1000 / 1024
    else if (u == "MB") kb = n * 1000 ^ 2 / 1024
    else if (u == "GB") kb = n * 1000 ^ 3 / 1024
    else if (u == "TB") kb = n * 1000 ^ 4 / 1024
    else { print "?"; exit }
    printf "%d\n", kb
  }'
}

# Resolves the Docker context once. Every later docker call passes
# --context "$DOCKER_CTX", so scans and actions use the same daemon.
docker_context() {
  case "$DOCKER_CTX_STATE" in
    ok) return 0 ;;
    failed) return 1 ;;
  esac
  DOCKER_CTX_STATE=failed
  if ! have docker; then
    warn "docker not found; skipping docker"
    return 1
  fi
  # Without a name, inspects the context docker commands would use.
  ctx_line=$(first_line docker context inspect --format '{{.Name}} {{.Endpoints.docker.Host}}')
  ctx=${ctx_line%% *}
  endpoint=${ctx_line#* }
  if [ -z "$ctx" ]; then
    warn "cannot resolve the docker context; skipping docker"
    return 1
  fi
  case "$endpoint" in
    ''|'<no value>') endpoint=unknown ;;
  esac
  DOCKER_CTX=$ctx
  DOCKER_ENDPOINT=$endpoint
  DOCKER_CTX_STATE=ok
}

docker_endpoint_local() {
  case "$DOCKER_ENDPOINT" in
    unix://*) return 0 ;;
  esac
  return 1
}

# Sets DOCKER_VOLUME_ROWS to "name<TAB>links<TAB>size" lines, once.
docker_volume_rows() {
  case "$DOCKER_VOLUMES_STATE" in
    ok) return 0 ;;
    failed) return 1 ;;
  esac
  DOCKER_VOLUMES_STATE=failed
  DOCKER_VOLUME_ROWS=$(docker --context "$DOCKER_CTX" system df -v \
    --format '{{range .Volumes}}{{.Name}}{{"\t"}}{{.Links}}{{"\t"}}{{.Size}}{{println}}{{end}}' 2>/dev/null) || {
    warn "cannot list Docker volumes"
    return 1
  }
  DOCKER_VOLUMES_STATE=ok
}

scan_docker() {
  docker_context || return 0
  if ! docker_endpoint_local && [ "$YES" -eq 1 ]; then
    warn "docker endpoint $DOCKER_ENDPOINT is not a local unix:// socket; skipping docker cleanup. Run without -y to confirm."
    return 0
  fi
  DOCKER_DF=$(docker --context "$DOCKER_CTX" system df --format '{{.Type}}\t{{.Size}}\t{{.Reclaimable}}' 2>/dev/null) || {
    warn "docker is not reachable; skipping docker cleanup"
    DOCKER_DF=
    return 0
  }
  docker_kb=0
  while IFS="$TAB" read -r type _ reclaimable; do
    case "$type" in
      ''|'Local Volumes') continue ;;
    esac
    kb=$(docker_size_kb "$reclaimable")
    case "$kb" in
      ''|*[!0-9]*) continue ;;
    esac
    docker_kb=$((docker_kb + kb))
  done <<EOF
$DOCKER_DF
EOF
  if [ "$DOCKER_MODE" = dangling ]; then
    add_estimate docker "$docker_kb" \
      "Docker dangling images, containers, build cache; volumes kept" \
      docker_dangling "$DOCKER_CTX"
  else
    add_estimate docker "$docker_kb" \
      "Docker unused images (including tagged), containers, build cache; volumes kept" \
      docker_all "$DOCKER_CTX"
  fi
  if [ "$docker_kb" -gt 0 ]; then
    DOCKER_TARGET="$DOCKER_ENDPOINT (context $DOCKER_CTX)"
  fi
  DOCKER_SHOW_VOLUMES=1
}

# Docker's own volume name rule.
valid_volume_name() {
  case "$1" in
    *"$NL"*) return 1 ;;
  esac
  printf '%s\n' "$1" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9_.-]*$'
}

# Prints the IDs of containers, running or stopped, that mount volume $1.
# Fails when docker cannot answer.
docker_volume_users() {
  docker --context "$DOCKER_CTX" ps -a -q --filter "volume=$1" 2>/dev/null
}

scan_docker_volumes() {
  docker_context || return 0
  if ! docker_endpoint_local; then
    warn "docker endpoint $DOCKER_ENDPOINT is not a local unix:// socket; refusing to delete Docker volumes"
    return 0
  fi
  docker_volume_rows || return 0
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    if ! docker --context "$DOCKER_CTX" volume inspect --format '{{.Name}}' "$name" >/dev/null 2>&1; then
      warn "Docker volume $name not found on $DOCKER_ENDPOINT; skipping it"
      continue
    fi
    row=$(printf '%s\n' "$DOCKER_VOLUME_ROWS" | awk -F '\t' -v n="$name" '$1 == n' | sed -n '1p')
    if [ -z "$row" ]; then
      warn "cannot tell whether a container uses Docker volume $name; keeping it"
      continue
    fi
    links=$(printf '%s\n' "$row" | cut -f 2)
    size=$(printf '%s\n' "$row" | cut -f 3)
    if ! users=$(docker_volume_users "$name"); then
      warn "cannot list containers that use Docker volume $name; keeping it"
      continue
    fi
    if [ "$links" != 0 ] || [ -n "$users" ]; then
      warn "Docker volume $name is used by a container or its use is unknown; keeping it"
      continue
    fi
    kb=$(docker_size_kb "$size")
    label="Docker volume $name (docker volume rm; type the name to confirm)"
    arg="$DOCKER_CTX$TAB$DOCKER_ENDPOINT$TAB$name"
    case "$kb" in
      ''|*[!0-9]*|0) add docker-volume 0 "$label" docker_volume "$arg" unknown ;;
      *) add_estimate docker-volume "$kb" "$label" docker_volume "$arg" ;;
    esac
    DOCKER_TARGET="$DOCKER_ENDPOINT (context $DOCKER_CTX)"
  done <<EOF
$DOCKER_VOLUMES
EOF
}

# Lists Docker volumes. None is part of a plan unless named with
# --docker-volume.
print_docker_volumes() {
  docker_volume_rows || return 0
  [ -n "$DOCKER_VOLUME_ROWS" ] || return 0
  echo "Docker volumes kept (context $DOCKER_CTX, $DOCKER_ENDPOINT):"
  while IFS="$TAB" read -r name links size; do
    [ -n "$name" ] || continue
    if printf '%s' "$DOCKER_VOLUMES" | grep -qxF -- "$name"; then
      continue
    fi
    kb=$(docker_size_kb "$size")
    case "$kb" in
      ''|*[!0-9]*) shown='?' ;;
      *) shown=$(fmt_kb "$kb") ;;
    esac
    case "$links" in
      0) use="no containers use it" ;;
      ''|*[!0-9]*) use="container use unknown" ;;
      *) use="used by $links container(s)" ;;
    esac
    if printf '%s\n' "$name" | grep -Eq '^[0-9a-f]{64}$'; then
      use="$use; anonymous"
    fi
    printf '  %8s  %s  (%s)\n' "$shown" "$name" "$use"
  done <<EOF
$DOCKER_VOLUME_ROWS
EOF
  echo "  To delete one: consuela --docker-volume NAME, then type the name."
}

# Rechecks each planned XcodeBuildMCP DerivedData folder, then wipes its
# contents.
mcp_derived_data_clear() {
  while IFS= read -r dd; do
    [ -n "$dd" ] || continue
    [ -e "$dd" ] || [ -L "$dd" ] || continue
    ws=${dd%/*}
    if ! mcp_workspace_idle "$ws"; then
      echo "  skipped ${ws##*/}: XcodeBuildMCP holds a lock there now" >&2
      fail
    elif ! mcp_derived_data_generated "$dd"; then
      echo "refusing to delete unsafe path: $dd" >&2
      fail
    else
      run_ok clear_dir "$dd"
    fi
  done <<EOF
$1
EOF
}

# Rechecks each planned test products folder, then deletes it and its
# completion marker.
mcp_test_products_remove() {
  while IFS= read -r t; do
    [ -n "$t" ] || continue
    [ -e "$t" ] || [ -L "$t" ] || continue
    if ! parent=$(canonical_dir "${t%/*}") ||
      ! mcp_generated_path "$parent" test-products ||
      [ -L "${t%/*}" ] ||
      ! mcp_test_products_done "$parent/${t##*/}"; then
      echo "refusing to delete unsafe or active path: $t" >&2
      fail
      continue
    fi
    if ! mcp_workspace_idle "${parent%/*}"; then
      echo "  skipped $t: XcodeBuildMCP holds a lock there now" >&2
      fail
      continue
    fi
    real="$parent/${t##*/}"
    run_ok rm -rf -- "$real"
    if [ -f "$real.xcodebuildmcp-completed" ] && [ ! -L "$real.xcodebuildmcp-completed" ]; then
      run_ok rm -f -- "$real.xcodebuildmcp-completed"
    fi
  done <<EOF
$1
EOF
}

# Deletes one Docker volume after the user types its name at a terminal.
# Checks the pinned context and the volume's users again right before
# docker volume rm, which itself refuses volumes in use.
docker_volume_remove() {
  ctx=$(printf '%s\n' "$1" | cut -f 1)
  endpoint=$(printf '%s\n' "$1" | cut -f 2)
  name=$(printf '%s\n' "$1" | cut -f 3)
  if ! valid_volume_name "$name"; then
    echo "refusing invalid volume name: $name" >&2
    fail
    return 0
  fi
  if [ ! -t 0 ]; then
    echo "  kept Docker volume $name: deleting a volume needs its name typed at a terminal" >&2
    fail
    return 0
  fi
  echo "  Volume $name on $endpoint (context $ctx). Its data cannot be restored."
  printf '  Type the volume name to delete it: '
  read -r typed || typed=
  if [ "$typed" != "$name" ]; then
    echo "  kept Docker volume $name: name not confirmed" >&2
    fail
    return 0
  fi
  now=$(first_line docker context inspect --format '{{.Endpoints.docker.Host}}' "$ctx")
  if [ "$now" != "$endpoint" ]; then
    echo "  kept Docker volume $name: context $ctx now points to ${now:-nothing}" >&2
    fail
    return 0
  fi
  if ! users=$(docker --context "$ctx" ps -a -q --filter "volume=$name" 2>/dev/null); then
    echo "  kept Docker volume $name: cannot list containers that use it" >&2
    fail
    return 0
  fi
  if [ -n "$users" ]; then
    echo "  kept Docker volume $name: a container uses it now" >&2
    fail
    return 0
  fi
  run_ok docker --context "$ctx" volume rm "$name"
}

run_action() {
  action=$1
  arg=$2
  case "$action" in
    simctl_set)
      if [ -d "$arg" ]; then
        if real=$(canonical_dir "$arg") && path_is_allowed_real "$real"; then
          run_ok xcrun simctl --set "$real" delete all
        else
          echo "refusing to delete unsafe path: $arg" >&2
          fail
        fi
      fi
      ;;
    mcp_derived_data)
      mcp_derived_data_clear "$arg"
      ;;
    mcp_test_products)
      mcp_test_products_remove "$arg"
      ;;
    docker_volume)
      docker_volume_remove "$arg"
      ;;
    simctl_unavailable)
      run_ok xcrun simctl delete unavailable
      ;;
    runtime_unavailable)
      run_ok xcrun simctl runtime delete "$arg"
      ;;
    clear_dir)
      clear_paths_from "$arg"
      ;;
    cocoapods)
      if have pod; then
        if ! pod cache clean --all >/dev/null 2>&1; then
          run_ok clear_dir "$arg"
        fi
      else
        run_ok clear_dir "$arg"
      fi
      ;;
    npm_clean)
      run_ok npm cache clean --force
      ;;
    yarn_clean)
      if yarn cache clean --all; then
        :
      else
        run_ok yarn cache clean
      fi
      ;;
    brew_cleanup)
      run_ok brew cleanup
      ;;
    pnpm_prune)
      run_ok pnpm store prune
      ;;
    pip_purge)
      python3 -m pip cache purge || {
        warn "pip cache purge failed; clearing $arg"
        run_ok clear_dir "$arg"
      }
      ;;
    uv_clean)
      run_ok uv cache clean
      ;;
    docker_all)
      run_ok docker --context "$arg" system prune -af
      ;;
    docker_dangling)
      run_ok docker --context "$arg" system prune -f
      ;;
    *)
      warn "unknown action $action"
      fail
      ;;
  esac
}

run_plan() {
  FAILED_STEPS=
  i=1
  while [ "$i" -le "$PLAN_COUNT" ]; do
    rec=$(plan_rec "$i")
    STEP=$(sed -n '1p' "$rec/label")
    action=$(sed -n '1p' "$rec/action")
    arg=$(cat "$rec/arg")
    echo "Cleaning $STEP..."
    before=$FAIL_COUNT
    run_action "$action" "$arg"
    if [ "$FAIL_COUNT" -ne "$before" ]; then
      FAILED_STEPS="$FAILED_STEPS  $STEP
"
    fi
    i=$((i + 1))
  done
}

# Usage: review_line <path> <label> <note>. Prints nothing for a missing path.
review_line() {
  m=$(measure_kb "$1")
  [ "$m" != missing ] || return 0
  kb=${m%% *}
  shown=$(fmt_kb "$kb")
  if [ "${m#* }" = partial ]; then
    shown=">$shown"
    note="$3; part of it is unreadable"
  else
    note=$3
  fi
  printf '  %9s  %s\n' "$shown" "$2"
  printf '             %s\n' "$note"
}

# ShipIt caches hold app updates that Squirrel staged. A pending update is
# the one named by updateBundleURL in ShipItState.plist, which is JSON.
report_shipit() {
  for d in "$HOME"/Library/Caches/*.ShipIt; do
    [ -d "$d" ] || continue
    name=${d##*/}
    if [ -L "$d" ]; then
      printf '  %9s  ~/Library/Caches/%s\n' '?' "$name"
      printf '             symlink; not measured\n'
      continue
    fi
    staged=$(find "$d" -mindepth 1 -maxdepth 1 -type d -name 'update.*' 2>/dev/null | grep -c . || :)
    [ "${staged:-0}" -gt 0 ] || continue
    note="$staged staged update(s)"
    if pending=$(shipit_url_path "$d/ShipItState.plist" updateBundleURL); then
      case "$pending" in
        "$d"/*)
          p=${pending#"$d"/}
          note="$note; pending install: ${p%%/*}"
          ;;
      esac
    else
      note="$note; ShipItState.plist unreadable"
    fi
    if target=$(shipit_url_path "$d/ShipItState.plist" targetBundleURL) && [ -e "$target" ]; then
      note="$note; app installed at $target"
    fi
    if procs=$(pgrep_procs -f "$name" 2>/dev/null) && [ -n "$procs" ]; then
      note="$note; updater running"
    fi
    review_line "$d" "$TILDE/Library/Caches/$name" "$note; let the app finish or discard its update"
  done
}

report_fusion() {
  prod="$HOME/Library/Application Support/Autodesk/webdeploy/production"
  [ -d "$prod" ] || return 0
  active=
  for link in "$prod"/*.app; do
    [ -L "$link" ] || continue
    target=$(readlink "$link") || continue
    case "$target" in
      /*) ;;
      *) target="$prod/$target" ;;
    esac
    [ -e "$target" ] || continue
    t=${target#"$prod"/}
    active="$active${t%%/*}$NL"
  done
  for v in "$prod"/*/; do
    v=${v%/}
    [ -d "$v" ] && [ ! -L "$v" ] || continue
    case "${v##*/}" in
      *.app) continue ;;
    esac
    if printf '%s' "$active" | grep -qxF -- "${v##*/}"; then
      note="active Fusion install (launcher points here); keep"
    else
      note="no launcher points here; remove only through Autodesk's tools"
    fi
    review_line "$v" "Fusion webdeploy ${v##*/}" "$note"
  done
}

report_playwright() {
  pw="$HOME/Library/Caches/ms-playwright"
  [ -d "$pw" ] || return 0
  for b in "$pw"/*/; do
    b=${b%/}
    review_line "$b" "Playwright ${b##*/}" \
      "projects may still use it; npx playwright uninstall keeps browsers other installs use"
  done
}

report_previews_orphans() {
  base="$HOME/$PREVIEWS_REL"
  n=0
  orphan_kb=0
  for d in "$base/Simulator Devices"/*/; do
    d=${d%/}
    [ -d "$d" ] && [ ! -L "$d" ] || continue
    [ ! -f "$d/device.plist" ] || continue
    n=$((n + 1))
    orphan_kb=$((orphan_kb + $(du_kb "$d")))
  done
  if [ "$n" -gt 0 ]; then
    printf '  %9s  %s\n' "$(fmt_kb "$orphan_kb")" "$n folder(s) in the Previews set without device.plist"
    printf '             %s\n' "not registered simulators, so simctl leaves them"
  fi
  review_line "$base/Simulator%20Devices" "$TILDE/$PREVIEWS_REL/Simulator%20Devices" \
    "not a simctl device set; consuela leaves it"
}

report_docker_disk() {
  for img in \
    "$HOME/Library/Containers/com.docker.docker/Data/vms/0/data/Docker.raw" \
    "$HOME/Library/Group Containers/HUAQ24HBR6.dev.orbstack/data/data.img"; do
    [ -f "$img" ] || continue
    bytes=$(stat -f %z "$img" 2>/dev/null) || continue
    logical=$(fmt_kb $((bytes / 1024)))
    review_line "$img" "${img##*/} (allocated on disk)" \
      "logical size $logical; Docker objects use part of it, the rest is not proven free"
  done
  [ -n "$DOCKER_DF" ] || return 0
  echo "  Docker system df (context $DOCKER_CTX; rows share layers, so do not add them):"
  printf '%s\n' "$DOCKER_DF" | while IFS="$TAB" read -r type size reclaimable; do
    [ -n "$type" ] || continue
    printf '             %s: %s total, %s reclaimable\n' "$type" "$size" "$reclaimable"
  done
}

report_review() {
  echo "Review only (consuela never deletes these; sizes measured on disk):"
  review_line /Library/Developer/CoreSimulator/Caches/dyld \
    /Library/Developer/CoreSimulator/Caches/dyld \
    "simulator runtime dyld cache owned by root; no supported cleanup"
  review_line "$HOME/Library/Developer/CoreSimulator/Devices" \
    "$TILDE/Library/Developer/CoreSimulator/Devices" \
    "available simulators; delete ones you no longer use in Xcode > Devices and Simulators"
  review_line "$HOME/Library/Developer/Xcode/iOS DeviceSupport" \
    "$TILDE/Library/Developer/Xcode/iOS DeviceSupport" \
    "symbols for devices you connected; keep the folder for your current device's iOS version"
  report_previews_orphans
  report_shipit
  report_playwright
  report_fusion
  review_line "$HOME/Library/Application Support/Notion/Partitions/notion" \
    "Notion Partitions" "may hold offline pages; clear it from Notion's settings"
  review_line "$HOME/Library/Application Support/Spotify/PersistentCache" \
    "Spotify PersistentCache" "may hold downloads; set the cache limit in Spotify's settings"
  review_line "$HOME/Library/Caches/com.spotify.client" \
    "$TILDE/Library/Caches/com.spotify.client" "may hold downloads; clear it from Spotify's settings"
  review_line "$HOME/Library/Application Support/Linear/Cache" \
    "Linear Cache" "app cache; quit Linear before any manual cleanup"
  review_line "$HOME/Library/Application Support/Linear/Code Cache" \
    "Linear Code Cache" "app cache; quit Linear before any manual cleanup"
  review_line "$HOME/Library/Application Support/BambuStudio/log" \
    "BambuStudio logs" "app logs; check dates before deleting any by hand"
  review_line "$HOME/Library/Caches/pypoetry/virtualenvs" \
    "Poetry virtualenvs" "project environments; --cache keeps them"
  report_docker_disk
}

# Read-only: scans every group and prints sizes. Never runs run_plan.
run_report() {
  echo "Storage report. Read-only: nothing is deleted, with or without -y."
  echo "Scanning..."
  scan_xcode
  scan_xcode_previews
  scan_xcodebuildmcp
  scan_cache
  scan_docker
  scan_unknown_caches

  defaults="xcode cache docker"
  optin="xcode-previews xcodebuildmcp"
  echo
  echo "Cleanup targets (size measured on disk; ~ = estimated reclaimable; ? = unknown):"
  if [ "$PLAN_COUNT" -eq 0 ]; then
    echo "  none"
  else
    print_plan "$(($(sum_plan_kb estimate) + $(count_plan unknown)))" flag
  fi
  echo
  printf 'Default run (consuela with no flags): %s\n' "$(fmt_run_total \
    "$(sum_plan_kb firm "$defaults")" "$(sum_plan_kb estimate "$defaults")" \
    "$(count_plan unknown "$defaults")")"
  printf 'Opt-in flags together:                %s\n' "$(fmt_run_total \
    "$(sum_plan_kb firm "$optin")" "$(sum_plan_kb estimate "$optin")" \
    "$(count_plan unknown "$optin")")"
  echo
  if [ -n "$UNKNOWN_CACHES" ]; then
    print_unknown_caches "a run at a terminal asks about each one"
    echo
  fi
  if [ -n "$DOCKER_SHOW_VOLUMES" ]; then
    print_docker_volumes
    echo
  fi
  echo "Measuring review-only paths. Large folders can take a minute..."
  report_review
  echo
  echo "Report only: nothing deleted."
}

consuela_main() {
  if [ "$(uname -s)" != "Darwin" ]; then
    echo "consuela only runs on macOS." >&2
    exit 1
  fi

  ARGC=$#
  UPDATE=0
  SHOW_VERSION=0
  DO_XCODE=0
  DO_CACHE=0
  DO_DOCKER=0
  DO_PREVIEWS=0
  DO_MCP=0
  DOCKER_MODE=all
  ANY_GROUP=0
  YES=0
  DRY_RUN=0
  REPORT=0

  while [ $# -gt 0 ]; do
    case "$1" in
      --xcode) DO_XCODE=1; ANY_GROUP=1 ;;
      --cache|--caches) DO_CACHE=1; ANY_GROUP=1 ;;
      --docker|--docker-all) DO_DOCKER=1; ANY_GROUP=1; DOCKER_MODE=all ;;
      --docker-dangling) DO_DOCKER=1; ANY_GROUP=1; DOCKER_MODE=dangling ;;
      --xcode-previews) DO_PREVIEWS=1; ANY_GROUP=1 ;;
      --xcodebuildmcp) DO_MCP=1; ANY_GROUP=1 ;;
      --docker-volume)
        if [ $# -lt 2 ] || ! valid_volume_name "$2"; then
          echo "error: --docker-volume needs a volume name" >&2
          usage >&2
          exit 1
        fi
        if ! printf '%s' "$DOCKER_VOLUMES" | grep -qxF -- "$2"; then
          DOCKER_VOLUMES="$DOCKER_VOLUMES$2$NL"
        fi
        ANY_GROUP=1
        shift
        ;;
      -y|--yes) YES=1 ;;
      --dry-run) DRY_RUN=1 ;;
      --report) REPORT=1 ;;
      --update) UPDATE=1 ;;
      --version) SHOW_VERSION=1 ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        echo "Unknown option: $1" >&2
        usage >&2
        exit 1
        ;;
    esac
    shift
  done

  if [ "$SHOW_VERSION" -eq 1 ]; then
    if [ "$ARGC" -ne 1 ]; then
      echo "error: --version must be the only argument" >&2
      usage >&2
      exit 1
    fi
    echo "consuela $VERSION"
    exit 0
  fi

  if [ "$UPDATE" -eq 1 ]; then
    if [ "$ARGC" -ne 1 ]; then
      echo "error: --update must be the only argument" >&2
      usage >&2
      exit 1
    fi
    self_update "$0" || exit 1
    exit 0
  fi

  if [ "$REPORT" -eq 1 ] && [ "$ANY_GROUP" -eq 1 ]; then
    echo "error: --report scans every group; it takes no group flags" >&2
    usage >&2
    exit 1
  fi

  if [ "$ANY_GROUP" -eq 0 ]; then
    DO_XCODE=1
    DO_CACHE=1
    DO_DOCKER=1
  fi

  # Project config in the caller's directory must not redirect cache commands.
  cd -- "$HOME_REAL"
  # Path lookups must not leave files behind: python3 bytecode caches in
  # ~/Library, npm debug logs and update checks in ~/.npm.
  PYTHONDONTWRITEBYTECODE=1
  npm_config_logs_max=0
  npm_config_update_notifier=false
  export PYTHONDONTWRITEBYTECODE npm_config_logs_max npm_config_update_notifier

  plan_init
  trap 'rm -rf "$PLAN_DIR"' EXIT

  if [ "$REPORT" -eq 1 ]; then
    YES=0
    run_report
    exit 0
  fi

  echo "Scanning..."

  if [ "$DO_XCODE" -eq 1 ]; then
    scan_xcode
  fi
  if [ "$DO_PREVIEWS" -eq 1 ]; then
    scan_xcode_previews
  fi
  if [ "$DO_MCP" -eq 1 ]; then
    scan_xcodebuildmcp
  fi
  if [ "$DO_CACHE" -eq 1 ]; then
    scan_cache
  fi
  if [ "$DO_DOCKER" -eq 1 ]; then
    scan_docker
  fi
  if [ -n "$DOCKER_VOLUMES" ]; then
    scan_docker_volumes
  fi
  if [ "$DO_CACHE" -eq 1 ]; then
    scan_unknown_caches
  fi

  firm_kb=$(sum_plan_kb firm)
  estimate_kb=$(sum_plan_kb estimate)
  unknown_n=$(count_plan unknown)

  echo
  printf 'This run:   %s\n' "$(fmt_run_total "$firm_kb" "$estimate_kb" "$unknown_n")"

  if [ "$PLAN_COUNT" -eq 0 ]; then
    echo
    if [ -n "$DOCKER_SHOW_VOLUMES" ]; then
      print_docker_volumes
      echo
    fi
    if [ -z "$UNKNOWN_CACHES" ]; then
      echo "Nothing to clean."
      exit 0
    fi
    FAILED_STEPS=
    handle_unknown_caches
    if [ "$DRY_RUN" -eq 1 ]; then
      echo "Dry run: nothing deleted."
      exit 0
    fi
    finish_run
  fi

  echo
  print_plan "$((estimate_kb + unknown_n))"
  echo

  if [ -n "$DOCKER_SHOW_VOLUMES" ]; then
    print_docker_volumes
    echo
  fi
  if [ "$DRY_RUN" -eq 1 ]; then
    handle_unknown_caches
  fi

  need_confirm=$((1 - YES))

  xcode_guard=
  if plan_has_xcode; then
    if ! xcode_tools=$(running_xcode_tools); then
      xcode_guard="Xcode tool check failed"
      echo "$xcode_guard. Make sure Xcode, Simulator, booted simulators, and xcodebuild are stopped."
      need_confirm=1
    elif [ -n "$xcode_tools" ]; then
      xcode_guard="Xcode tools running: $xcode_tools"
      echo "$xcode_guard"
      echo "Stop them before you continue."
      need_confirm=1
    elif [ "$DRY_RUN" -eq 0 ]; then
      echo "Do not start Xcode builds or tests until cleanup finishes."
    fi
  fi

  if [ -n "$DOCKER_TARGET" ]; then
    echo "Docker endpoint: $DOCKER_TARGET"
  fi
  if plan_has_group docker-volume; then
    echo "Each Docker volume asks for its name before it is deleted, even with -y."
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    echo "Dry run: nothing deleted."
    exit 0
  fi

  if [ "$need_confirm" -eq 1 ]; then
    if [ "$YES" -eq 1 ] && [ -n "$xcode_guard" ] && [ ! -t 0 ]; then
      echo "-y ignored: $xcode_guard" >&2
    fi
    printf 'Proceed? [y/N] '
    read -r ans || ans=n
    echo
    case "$ans" in
      y|Y|yes|YES) ;;
      *)
        echo "Aborted." >&2
        exit 1
        ;;
    esac
  fi

  echo
  run_plan
  if [ -n "$UNKNOWN_CACHES" ]; then
    echo
    handle_unknown_caches
  fi
  finish_run
}

FAIL_COUNT=0
STEP=
DOCKER_CTX=
DOCKER_ENDPOINT=
DOCKER_CTX_STATE=
DOCKER_DF=
DOCKER_TARGET=
DOCKER_VOLUMES=
DOCKER_VOLUMES_STATE=
DOCKER_VOLUME_ROWS=
DOCKER_SHOW_VOLUMES=
